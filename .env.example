# Copie para .env (o Bun carrega .env automaticamente).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Identifica a réplica nos logs e métricas (no Compose, cada réplica usa o hostname).
# INSTANCE_ID=local  (default: hostname do container)

# PostgreSQL (docker compose)
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DATABASE_POOL_MAX=10
# Espera máxima por uma conexão livre do pool (ms); esgotada, a requisição responde 503 + Retry-After.
# Mantenha acima de DB_LOCK_TIMEOUT_MS × DB_TRANSACTION_MAX_ATTEMPTS + backoff.
# DB_POOL_ACQUIRE_TIMEOUT_MS=10000
# Espera máxima por um lock de linha (ms) e tentativas por transação em conflito de concorrência (T14).
# DB_LOCK_TIMEOUT_MS=2000
# DB_TRANSACTION_MAX_ATTEMPTS=3
# Teto de cada checagem do /health/ready (ms).
# HEALTH_CHECK_TIMEOUT_MS=1000
# Por quanto tempo (ms) o resultado do /health/ready é reaproveitado; 0 desliga o cache.
# HEALTH_CHECK_CACHE_MS=1000

# SQS via LocalStack (docker compose)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo
# Consumer SQS da fila de transações (T22). Todas as variáveis abaixo são opcionais.
# Liga ou desliga o loop de long polling desta réplica.
# SQS_CONSUMER_ENABLED=true
# Espera do long polling em segundos (0 a 20).
# SQS_CONSUMER_WAIT_TIME_SECONDS=20
# Mensagens por receive (1 a 10).
# SQS_CONSUMER_BATCH_SIZE=10
# Recebimentos antes de mandar a mensagem para a DLQ; mantenha igual ou abaixo do maxReceiveCount da fila (5).
# SQS_CONSUMER_MAX_RECEIVES=5
# Backoff exponencial (ms) do retry de falha transitória, aplicado via ChangeMessageVisibility (granularidade de 1 s).
# SQS_CONSUMER_RETRY_BASE_DELAY_MS=1000
# SQS_CONSUMER_RETRY_MAX_DELAY_MS=60000
# Teto (ms) para concluir as mensagens em andamento no desligamento; mantenha abaixo do stop_grace_period do compose (30 s).
# SQS_CONSUMER_SHUTDOWN_TIMEOUT_MS=20000
# Publisher da outbox (T23): publica os eventos de integração em wagering-events.fifo. Todas as variáveis abaixo são opcionais.
# Liga ou desliga o loop de publicação desta réplica.
# OUTBOX_PUBLISHER_ENABLED=true
# Eventos reivindicados por ciclo (1 a 10, limite do SendMessageBatch).
# OUTBOX_PUBLISHER_BATCH_SIZE=10
# Pausa (ms) entre ciclos quando não há backlog para drenar.
# OUTBOX_PUBLISHER_POLL_INTERVAL_MS=1000
# Teto (ms) do envio ao SQS: a transação que reivindica o lote segura uma conexão e os locks das linhas durante o envio.
# OUTBOX_PUBLISH_TIMEOUT_MS=5000
