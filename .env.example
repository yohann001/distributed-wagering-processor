# Copie para .env (o Bun carrega .env automaticamente).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Identifica a réplica nos logs e métricas (no Compose, cada réplica usa o hostname).
# INSTANCE_ID=local  (default: hostname do container)

# PostgreSQL (docker compose)
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DATABASE_POOL_MAX=10
# Espera máxima por uma conexão livre do pool (ms); esgotada, a requisição responde 503 + Retry-After.
# Mantenha acima de DB_LOCK_TIMEOUT_MS × DB_TRANSACTION_MAX_ATTEMPTS + backoff.
# DB_POOL_ACQUIRE_TIMEOUT_MS=10000
# Espera máxima por um lock de linha (ms) e tentativas por transação em conflito de concorrência (T14).
# DB_LOCK_TIMEOUT_MS=2000
# DB_TRANSACTION_MAX_ATTEMPTS=3
# Teto de cada checagem do /health/ready (ms).
# HEALTH_CHECK_TIMEOUT_MS=1000
# Por quanto tempo (ms) o resultado do /health/ready é reaproveitado; 0 desliga o cache.
# HEALTH_CHECK_CACHE_MS=1000

# SQS via LocalStack (docker compose)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
