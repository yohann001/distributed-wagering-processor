{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distributed Wagering Processor — desafio técnico Jungle Gaming",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration --timeout 30000",
    "test:concurrency": "bun test ./test/concurrency --timeout 120000",
    "migration:create": "bun node_modules/@mikro-orm/cli/cli.js migration:create",
    "migration:up": "bun node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "bun node_modules/@mikro-orm/cli/cli.js migration:down",
    "migration:list": "bun node_modules/@mikro-orm/cli/cli.js migration:list",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/infrastructure/database/mikro-orm.config.ts"
    ],
    "alwaysAllowTs": true
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1155.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "decimal.js": "10.6.0",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.17",
    "@nestjs/testing": "11.2.7",
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
